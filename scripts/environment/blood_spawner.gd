extends Node3D
## Blood stains made with Godot 4 Decal nodes (Forward+ / Mobile renderers).
##
## How it works:
##   A Decal projects a texture along its local -Y axis onto every mesh inside its box.
##   - Floor stains: the Decal points down (default rotation).
##   - Wall stains: the Decal is rotated so its -Y points into the wall.
##   The textures are generated by code (no image files needed). Each Decal only
##   affects visual layer 1 (the lab), so players and infected (layer 2) are never stained.
##
## Usage from the floor script:
##   var blood = BloodSpawner.new(); add_child(blood)
##   blood.spawn_in_room(cells, amount, cell_to_world, wall_check)
##   blood.splatter_floor(position, size)    # anywhere
##   blood.pool(position)                     # when an infected dies

const TEXTURE_COUNT := 6
const TEXTURE_SIZE := 128
const MAX_DYNAMIC := 60          # hits and pools; the oldest ones are removed
const BLOOD_COLOR := Color(0.32, 0.0, 0.0)

static var _textures: Array[ImageTexture] = []

var _rng := RandomNumberGenerator.new()
var _dynamic: Array[Decal] = []


func _ready() -> void:
	_rng.seed = 666
	if _textures.is_empty():
		for i in TEXTURE_COUNT:
			_textures.append(_make_texture(i))


## Random stains in a room: floor splatters, wall splatters and drag trails.
## cells: Array of Vector2i · to_world: Callable(Vector2i) -> Vector3
## wall_dir: Callable(Vector2i) -> Vector2i (direction of a wall next to the cell, or ZERO)
func spawn_in_room(cells: Array, amount: int, to_world: Callable, wall_dir: Callable, cell_size: float) -> void:
	if cells.is_empty():
		return
	for i in amount:
		var cell: Vector2i = cells[_rng.randi_range(0, cells.size() - 1)]
		var center: Vector3 = to_world.call(cell)
		var offset := Vector3(_rng.randf_range(-1.0, 1.0), 0, _rng.randf_range(-1.0, 1.0)) * cell_size * 0.4
		var roll := _rng.randf()
		if roll < 0.6:
			splatter_floor(center + offset, _rng.randf_range(0.8, 2.2), false)
		elif roll < 0.85:
			var dir: Vector2i = wall_dir.call(cell)
			if dir != Vector2i.ZERO:
				var normal := -Vector3(dir.x, 0, dir.y)
				var along := Vector3(normal.z, 0, -normal.x) * _rng.randf_range(-1.0, 1.0)
				var wall_point := center + Vector3(dir.x, 0, dir.y) * (cell_size / 2.0) + along
				wall_point.y = _rng.randf_range(0.6, 1.8)
				splatter_wall(wall_point, normal, _rng.randf_range(0.6, 1.4))
			else:
				splatter_floor(center + offset, 1.0, false)
		else:
			_trail(center + offset, _rng.randf() * TAU, _rng.randf_range(2.0, 4.0))


func splatter_floor(pos: Vector3, size: float, dynamic := true) -> Decal:
	var decal := _new_decal(size, 0.6)
	decal.position = Vector3(pos.x, 0.05, pos.z)
	decal.rotation.y = _rng.randf() * TAU
	add_child(decal)
	if dynamic:
		_track(decal)
	return decal


## normal: direction pointing out of the wall, into the room.
func splatter_wall(pos: Vector3, normal: Vector3, size: float) -> Decal:
	var decal := _new_decal(size, 0.5)
	var y := normal.normalized()
	var z := Vector3.UP
	var x := y.cross(z).normalized()
	decal.basis = Basis(x, y, z).rotated(y, _rng.randf() * TAU)
	decal.position = pos + y * 0.15
	add_child(decal)
	return decal


## Big pool under a dead infected.
func pool(pos: Vector3) -> void:
	var decal := splatter_floor(pos, _rng.randf_range(1.4, 2.0))
	decal.modulate = Color(0.8, 0.8, 0.8)
	decal.scale = Vector3(0.2, 1, 0.2)
	var tween := decal.create_tween()
	tween.tween_property(decal, "scale", Vector3.ONE, 2.5).set_ease(Tween.EASE_OUT)


## Small stain when a bullet hits an infected.
func hit_splash(pos: Vector3) -> void:
	splatter_floor(pos + Vector3(_rng.randf_range(-0.4, 0.4), 0, _rng.randf_range(-0.4, 0.4)), _rng.randf_range(0.3, 0.6))


func _trail(start: Vector3, angle: float, length: float) -> void:
	var dir := Vector3(cos(angle), 0, sin(angle))
	var steps := int(length / 0.45)
	for i in steps:
		var p := start + dir * (i * 0.45) + Vector3(_rng.randf_range(-0.08, 0.08), 0, _rng.randf_range(-0.08, 0.08))
		var decal := splatter_floor(p, _rng.randf_range(0.45, 0.7) * (1.0 - float(i) / steps * 0.5), false)
		decal.rotation.y = -angle


func _new_decal(size: float, depth: float) -> Decal:
	var decal := Decal.new()
	decal.texture_albedo = _textures[_rng.randi_range(0, _textures.size() - 1)]
	decal.size = Vector3(size, depth, size)
	decal.albedo_mix = 1.0
	decal.modulate = Color(1, 1, 1, _rng.randf_range(0.75, 1.0))
	decal.cull_mask = 1                   # only the lab (layer 1)
	decal.upper_fade = 0.2
	decal.lower_fade = 0.2
	decal.distance_fade_enabled = true
	decal.distance_fade_begin = 35.0
	decal.distance_fade_length = 10.0
	return decal


func _track(decal: Decal) -> void:
	_dynamic.append(decal)
	if _dynamic.size() > MAX_DYNAMIC:
		var old: Decal = _dynamic.pop_front()
		if is_instance_valid(old):
			old.queue_free()


## Blood splatter texture: a main blob, smaller drops around it and a few streaks.
static func _make_texture(seed_value: int) -> ImageTexture:
	var rng := RandomNumberGenerator.new()
	rng.seed = 1000 + seed_value
	var n := TEXTURE_SIZE
	var img := Image.create_empty(n, n, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var blobs: Array = []
	var c := Vector2(n / 2.0, n / 2.0)
	# main stain made of overlapping circles
	for i in 9:
		blobs.append([c + Vector2(rng.randf_range(-14, 14), rng.randf_range(-14, 14)), rng.randf_range(12, 26)])
	# drops
	for i in rng.randi_range(10, 22):
		var a := rng.randf() * TAU
		var d := rng.randf_range(25, 58)
		blobs.append([c + Vector2(cos(a), sin(a)) * d, rng.randf_range(1.5, 5.0)])
	# streaks (lines of tiny drops going outwards)
	for s in rng.randi_range(2, 5):
		var a := rng.randf() * TAU
		var r := rng.randf_range(4, 7)
		for k in 8:
			blobs.append([c + Vector2(cos(a), sin(a)) * (20 + k * 4.5), r * (1.0 - k / 9.0)])
	# strength of the stain per pixel (only the area around each drop is visited)
	var field := PackedFloat32Array()
	field.resize(n * n)
	for b in blobs:
		var center: Vector2 = b[0]
		var radius: float = b[1]
		var x0 := maxi(0, int(center.x - radius))
		var x1 := mini(n - 1, int(center.x + radius) + 1)
		var y0 := maxi(0, int(center.y - radius))
		var y1 := mini(n - 1, int(center.y + radius) + 1)
		for y in range(y0, y1 + 1):
			for x in range(x0, x1 + 1):
				var v := 1.0 - Vector2(x, y).distance_to(center) / radius
				if v > field[y * n + x]:
					field[y * n + x] = v
	for y in n:
		for x in n:
			var best := field[y * n + x]
			if best <= 0.0:
				continue
			var alpha := clampf(best * 4.0, 0.0, 1.0)
			var shade := 0.6 + 0.4 * clampf(best * 2.0, 0.0, 1.0)   # darker in the middle
			img.set_pixel(x, y, Color(BLOOD_COLOR.r * (2.0 - shade), 0.0, 0.0, alpha * 0.95))
	img.generate_mipmaps()
	return ImageTexture.create_from_image(img)
