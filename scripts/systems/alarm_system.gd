extends Node
## Emergency alarm: turns every lamp red, pulses them and plays the alarm sound.
## The floor registers its lamps, then calls start() when the boss gets the syringes.
##
## Sound: if ALARM_SOUND exists (e.g. you drop "alarm.mp3" in assets/audio) it is
## played in a loop. Otherwise a siren is generated by code, so it always sounds.

const Config = preload("res://scripts/systems/level_config.gd")

const ALARM_SOUND := "res://assets/audio/alarm.mp3"
const ALARM_SECONDS := 25.0     # how long the alarm sounds (0 = forever)
const ALARM_VOLUME_DB := -10.0
const MIX_RATE := 22050.0

signal alarm_finished

var active := false

var _env: Environment
var _lamp_mat: StandardMaterial3D
var _lamps: Array[OmniLight3D] = []
var _lamp_phase: Array[float] = []
var _time := 0.0
var _player: AudioStreamPlayer
var _playback: AudioStreamGeneratorPlayback   # only for the generated siren
var _sounding := false
var _phase := 0.0
var _siren_t := 0.0


func setup(env: Environment, lamp_mat: StandardMaterial3D) -> void:
	_env = env
	_lamp_mat = lamp_mat


func register_lamp(light: OmniLight3D) -> void:
	_lamps.append(light)
	_lamp_phase.append(randf() * TAU)


func _ready() -> void:
	_player = AudioStreamPlayer.new()
	_player.volume_db = ALARM_VOLUME_DB
	add_child(_player)


func start() -> void:
	active = true
	_time = 0.0
	for light in _lamps:
		light.light_color = Config.LIGHT_ALARM
	if _lamp_mat:
		_lamp_mat.albedo_color = Config.LIGHT_ALARM
		_lamp_mat.emission = Config.LIGHT_ALARM
	if _env:
		_env.ambient_light_color = Config.AMBIENT_ALARM
		_env.ambient_light_energy = 0.3
	_start_sound()


func _start_sound() -> void:
	_sounding = true
	if ResourceLoader.exists(ALARM_SOUND):
		var stream: AudioStream = load(ALARM_SOUND)
		if stream is AudioStreamWAV:
			stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
			stream.loop_end = int(stream.get_length() * stream.mix_rate)
		elif "loop" in stream:
			stream.loop = true
		_player.stream = stream
		_player.play()
		return
	var gen := AudioStreamGenerator.new()
	gen.mix_rate = MIX_RATE
	gen.buffer_length = 0.25
	_player.stream = gen
	_player.play()
	_playback = _player.get_stream_playback()


func stop_sound() -> void:
	if not _sounding:
		return
	_sounding = false
	_player.stop()
	_playback = null
	alarm_finished.emit()


func _process(delta: float) -> void:
	if not active:
		return
	_time += delta
	# Red lights pulsing
	for i in _lamps.size():
		var pulse := 0.5 + 0.5 * sin(_time * 4.0 + _lamp_phase[i])
		_lamps[i].light_energy = 0.6 + 2.2 * pulse
	if _lamp_mat:
		_lamp_mat.emission_energy_multiplier = 1.0 + 3.0 * (0.5 + 0.5 * sin(_time * 4.0))

	if not _sounding:
		return
	if ALARM_SECONDS > 0.0 and _time > ALARM_SECONDS:
		stop_sound()
		return
	# Fade out during the last 3 seconds
	if ALARM_SECONDS > 0.0:
		var fade := clampf((ALARM_SECONDS - _time) / 3.0, 0.0, 1.0)
		_player.volume_db = ALARM_VOLUME_DB + linear_to_db(maxf(fade, 0.001))
	if _playback:
		_fill_siren()


## Generated emergency siren: a rising/falling wail plus a short beep every second.
func _fill_siren() -> void:
	for i in _playback.get_frames_available():
		_siren_t += 1.0 / MIX_RATE
		var sweep := 0.5 + 0.5 * sin(_siren_t * TAU / 2.0)
		var freq := 600.0 + 500.0 * sweep
		_phase = fmod(_phase + freq / MIX_RATE, 1.0)
		var wail := sin(TAU * _phase) * 0.55 + (1.0 if _phase < 0.5 else -1.0) * 0.12
		var beep := 0.0
		if fmod(_siren_t, 1.0) < 0.08:
			beep = sin(TAU * 1800.0 * _siren_t) * 0.25
		var s := clampf(wail + beep, -1.0, 1.0) * 0.8
		_playback.push_frame(Vector2(s, s))
